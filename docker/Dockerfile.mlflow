# syntax=docker/dockerfile:1
# Serveur de tracking MLflow (UI + Model Registry), pour éviter de lancer
# `mlflow ui` manuellement à chaque fois. Contexte de build : la racine du dépôt.

# ---------- Stage 1 : build des dépendances dans un venv isolé ----------
FROM python:3.11-slim AS builder

WORKDIR /app

RUN python -m venv /opt/venv
ENV PATH="/opt/venv/bin:$PATH"

RUN pip install --no-cache-dir --upgrade pip && \
    pip install --no-cache-dir "mlflow>=2.11"

# ---------- Stage 2 : image d'exécution minimale ----------
FROM python:3.11-slim AS runtime

RUN useradd --create-home --uid 1000 --shell /usr/sbin/nologin appuser

WORKDIR /app

COPY --from=builder /opt/venv /opt/venv

# Stockage persistant (backend SQLite + artefacts), monté en volume par
# docker-compose. Chemin conteneur fixe, sans espace : évite le bug Windows
# rencontré avec un chemin hôte absolu (cf. conf/config.yaml).
RUN mkdir -p /mlflow-data && chown -R appuser:appuser /mlflow-data

ENV PATH="/opt/venv/bin:$PATH" \
    PYTHONUNBUFFERED=1

USER appuser

EXPOSE 5000

CMD ["mlflow", "server", \
     "--host", "0.0.0.0", \
     "--port", "5000", \
     "--backend-store-uri", "sqlite:////mlflow-data/mlflow.db", \
     "--default-artifact-root", "/mlflow-data/mlartifacts"]
